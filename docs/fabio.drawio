          </mxGeometry>
        </mxCell>

        <mxCell id="msg11" value="11. Retorna ClimaResponse (Record DTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#27AE60;fontStyle=1;" edge="1" parent="1" source="ll-climasrv" target="ll-ctrl">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="470" y="610" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg12" value="12. JSON 200 OK (ClimaResponse)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#007ACC;fontStyle=1;" edge="1" parent="1" source="ll-ctrl" target="ll-user">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="230" y="660" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg13" value="13. Renderiza Card de Temperatura e Mapa com Popup da Cidade" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeColor=#007ACC;" edge="1" parent="1" source="ll-user" target="ll-user">
          <mxGeometry relative="1" as="geometry">
