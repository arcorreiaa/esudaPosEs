        <mxCell id="ll-mapasrv" value="MapaService" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#EBF5FB;strokeColor=#2E86C1;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="800" y="110" width="140" height="680" as="geometry" />
        </mxCell>

        <mxCell id="ll-viacep" value="ViaCEP" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F4F6F6;strokeColor=#7F8C8D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1040" y="110" width="120" height="680" as="geometry" />
        </mxCell>

        <mxCell id="ll-nominatim" value="Nominatim" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F4F6F6;strokeColor=#7F8C8D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1220" y="110" width="120" height="680" as="geometry" />
        </mxCell>

        <mxCell id="ll-openmeteo" value="Open-Meteo" style="shape=umlLifeline;perimeter=lifelinePerimeter;whiteSpace=wrap;html=1;container=1;collapsible=0;recursiveResize=0;outlineConnect=0;fillColor=#F4F6F6;strokeColor=#7F8C8D;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="1400" y="110" width="120" height="680" as="geometry" />
        </mxCell>

        <!-- Mensagens de Sequência -->
        <mxCell id="msg1" value="1. Digita CEP e submete formulário" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;strokeColor=#007ACC;" edge="1" parent="1" source="ll-user" target="ll-ctrl">
          <mxGeometry relative="1" as="geometry">
            <mxPoint y="190" as="offset" />
            <Array as="points"><mxPoint x="230" y="190" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg2" value="2. buscarClimaPorCep(cep)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;strokeColor=#27AE60;" edge="1" parent="1" source="ll-ctrl" target="ll-climasrv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="470" y="230" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg3" value="3. buscarMapaPorCep(cep)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;strokeColor=#2E86C1;" edge="1" parent="1" source="ll-climasrv" target="ll-mapasrv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="710" y="270" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg4" value="4. GET /ws/{cep}/json/ (Timeout 5s/10s)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;strokeColor=#7F8C8D;" edge="1" parent="1" source="ll-mapasrv" target="ll-viacep">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="950" y="310" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg5" value="5. Retorna dados de endereço" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;" edge="1" parent="1" source="ll-viacep" target="ll-mapasrv">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="950" y="350" /></Array>
          </mxGeometry>
        </mxCell>

        <mxCell id="msg6" value="6. GET /search?q={endereco} (Geocoding)" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;strokeColor=#7F8C8D;" edge="1" parent="1" source="ll-mapasrv" target="ll-nominatim">
          <mxGeometry relative="1" as="geometry">
