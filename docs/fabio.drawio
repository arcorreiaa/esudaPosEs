          </mxGeometry>
        </mxCell>

        <mxCell id="msg8" value="8. Retorna MapaResponse (Record DTO)" style="html=1;verticalAlign=bottom;endArrow=open;dashed=1;endSize=8;rounded=0;strokeColor=#2E86C1;fontStyle=1;" edge="1" parent="1" source="ll-mapasrv" target="ll-climasrv">
