        </mxCell>

        <mxCell id="ext-nominatim" value="&lt;b&gt;OpenStreetMap Nominatim&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;https://nominatim.openstreetmap.org/search&lt;br&gt;&lt;i&gt;Retorna: latitude, longitude, display_name&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7F8C8D;fontSize=12;" vertex="1" parent="group-external">
          <mxGeometry x="25" y="240" width="290" height="90" as="geometry" />
