  <diagram id="fabio-diag-1" name="1. Visão Geral e Arquitetura">
    <mxGraphModel dx="1680" dy="950" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        
        <!-- Título do Diagrama -->
        <mxCell id="title-box" value="&lt;b&gt;&lt;font style=&quot;font-size: 22px;&quot;&gt;Arquitetura CEP + Clima (Melhorias - Fabio Emidio)&lt;/font&gt;&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 13px; color: #555555;&quot;&gt;Faculdade ESUDA • Spring Boot 4.1 • Java 17 • Records DTOs • RestClient Timeout • Actuator Health Check&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8f9fa;strokeColor=#d6d8db;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="30" width="1520" height="70" as="geometry" />
        </mxCell>

        <!-- Container Usuário & Navegador -->
        <mxCell id="group-client" value="CLIENTE / NAVEGADOR" style="swimlane;whiteSpace=wrap;html=1;fillColor=#E8F4F8;strokeColor=#007ACC;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="340" height="690" as="geometry" />
        </mxCell>

        <mxCell id="user-node" value="&lt;b&gt;Usuário Final&lt;/b&gt;&lt;br&gt;Navegador Web / Mobile" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fillColor=#007ACC;strokeColor=#005999;fontColor=#333333;" vertex="1" parent="group-client">
          <mxGeometry x="145" y="60" width="50" height="90" as="geometry" />
        </mxCell>

        <mxCell id="fe-node" value="&lt;b&gt;Frontend (SPA Estática)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• index.html (HTML5 + CSS + Vanilla JS)&lt;br&gt;• Leaflet JS (Mapa com Popup da Cidade)&lt;br&gt;• Meta SEO (Description, Robots)&lt;br&gt;• Máscara de CEP e Feedback Visual&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#007ACC;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="group-client">
          <mxGeometry x="25" y="210" width="290" height="130" as="geometry" />
        </mxCell>

        <mxCell id="docker-note" value="&lt;b&gt;Docker Health Check&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;docker-compose.yaml verifica status a cada 30s via /actuator/health&lt;/font&gt;" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FFF9C4;strokeColor=#FBC02D;fontSize=12;size=14;" vertex="1" parent="group-client">
          <mxGeometry x="25" y="440" width="290" height="80" as="geometry" />
        </mxCell>

        <!-- Container Backend Spring Boot -->
        <mxCell id="group-backend" value="BACKEND SPRING BOOT (api-cep-clima : 8080)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#EBF5FB;strokeColor=#2E86C1;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="420" y="140" width="760" height="690" as="geometry" />
        </mxCell>

        <!-- Configs & Actuator -->
        <mxCell id="be-webconfig" value="&lt;b&gt;WebConfig (CORS)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color:#555;&quot;&gt;Habilitado para /clima/** e /mapa/**&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="group-backend">
          <mxGeometry x="30" y="50" width="210" height="55" as="geometry" />
        </mxCell>

        <mxCell id="be-restconfig" value="&lt;b&gt;RestClientConfig (Bean)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color:#2E7D32;&quot;&gt;• Connect Timeout: 5s&lt;br&gt;• Read Timeout: 10s&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F8F5;strokeColor=#27AE60;fontSize=11;" vertex="1" parent="group-backend">
          <mxGeometry x="270" y="50" width="220" height="55" as="geometry" />
        </mxCell>

        <mxCell id="be-actuator" value="&lt;b&gt;Spring Actuator&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px; color:#555;&quot;&gt;GET /actuator/health (Status UP)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E86C1;fontSize=11;" vertex="1" parent="group-backend">
          <mxGeometry x="520" y="50" width="210" height="55" as="geometry" />
        </mxCell>

        <!-- Controllers -->
        <mxCell id="be-clima-ctrl" value="&lt;b&gt;ClimaController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;GET /clima/{cep}&lt;br&gt;Retorno: &lt;b&gt;ClimaResponse&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;" vertex="1" parent="group-backend">
          <mxGeometry x="30" y="140" width="330" height="70" as="geometry" />
        </mxCell>

        <mxCell id="be-mapa-ctrl" value="&lt;b&gt;MapaController&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;GET /mapa/{cep}&lt;br&gt;Retorno: &lt;b&gt;MapaResponse&lt;/b&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D4EFDF;strokeColor=#27AE60;fontSize=12;" vertex="1" parent="group-backend">
          <mxGeometry x="400" y="140" width="330" height="70" as="geometry" />
        </mxCell>

        <!-- Services -->
        <mxCell id="be-clima-srv" value="&lt;b&gt;ClimaService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Injeta MapaService e RestClient&lt;br&gt;• Orquestra chamada à API Open-Meteo&lt;br&gt;• Monta ClimaResponse com ClimaDto&lt;br&gt;• Logging SLF4J estruturado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E86C1;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="group-backend">
          <mxGeometry x="30" y="250" width="330" height="110" as="geometry" />
        </mxCell>

        <mxCell id="be-mapa-srv" value="&lt;b&gt;MapaService&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• Valida formato do CEP (com/sem hífen)&lt;br&gt;• Consulta ViaCEP (endereço)&lt;br&gt;• Consulta Nominatim (coordenadas)&lt;br&gt;• Monta MapaResponse (Record DTO)&lt;br&gt;• Logging SLF4J estruturado&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#2E86C1;align=left;spacingLeft=10;fontSize=12;" vertex="1" parent="group-backend">
          <mxGeometry x="400" y="250" width="330" height="110" as="geometry" />
        </mxCell>

        <!-- DTO Layer -->
        <mxCell id="be-dtos" value="&lt;b&gt;Camada DTO (Java Records — Imutáveis &amp; Type-Safe)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;• &lt;b&gt;EnderecoDto&lt;/b&gt; (logradouro, bairro, localidade, uf)&lt;br&gt;• &lt;b&gt;CoordenadasDto&lt;/b&gt; (latitude, longitude, nome)&lt;br&gt;• &lt;b&gt;ClimaDto&lt;/b&gt; (data, @JsonProperty temperatura_maxima_celsius)&lt;br&gt;• &lt;b&gt;MapaResponse&lt;/b&gt; (cep, endereco, coordenadas)&lt;br&gt;• &lt;b&gt;ClimaResponse&lt;/b&gt; (cep, endereco, coordenadas, clima)&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF9E7;strokeColor=#F39C12;align=left;spacingLeft=15;fontSize=12;" vertex="1" parent="group-backend">
          <mxGeometry x="30" y="390" width="700" height="120" as="geometry" />
        </mxCell>

        <!-- Exception Handler -->
        <mxCell id="be-ex-handler" value="&lt;b&gt;ApiExceptionHandler (@RestControllerAdvice)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;Captura ResponseStatusException e padroniza resposta JSON de erro: { &quot;message&quot;: &quot;...&quot; }&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FDEDEC;strokeColor=#E74C3C;fontSize=11;" vertex="1" parent="group-backend">
          <mxGeometry x="30" y="540" width="700" height="50" as="geometry" />
        </mxCell>

        <mxCell id="be-tests" value="&lt;b&gt;Testes Automatizados (JUnit 5)&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;MapaServiceTest: 9 testes unitários parametrizados para validação de CEP.&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EAFAF1;strokeColor=#2ECC71;fontSize=11;" vertex="1" parent="group-backend">
          <mxGeometry x="30" y="610" width="700" height="50" as="geometry" />
        </mxCell>

        <!-- Container APIs Externas -->
        <mxCell id="group-external" value="APIS EXTERNAS (SERVIÇOS PÚBLICOS)" style="swimlane;whiteSpace=wrap;html=1;fillColor=#F4F6F6;strokeColor=#7F8C8D;fontStyle=1;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="1220" y="140" width="340" height="690" as="geometry" />
        </mxCell>

        <mxCell id="ext-viacep" value="&lt;b&gt;ViaCEP API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;https://viacep.com.br/ws/{cep}/json/&lt;br&gt;&lt;i&gt;Retorna: logradouro, bairro, cidade, UF&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7F8C8D;fontSize=12;" vertex="1" parent="group-external">
