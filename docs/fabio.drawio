        <mxCell id="ext-openmeteo" value="&lt;b&gt;Open-Meteo Forecast API&lt;/b&gt;&lt;br&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;https://api.open-meteo.com/v1/forecast&lt;br&gt;&lt;i&gt;Retorna: temperatura máxima do dia&lt;/i&gt;&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#7F8C8D;fontSize=12;" vertex="1" parent="group-external">
          <mxGeometry x="25" y="410" width="290" height="90" as="geometry" />
        </mxCell>

        <!-- Conexões / Fluxos -->
