        <mxCell id="bld-local" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#64748B;fontColor=#334155;fontSize=12;strokeWidth=2;align=left;spacingLeft=12;" value="&lt;b&gt;Execução local com Maven&lt;/b&gt;&lt;br&gt;cd cep-clima/backend&lt;br&gt;./mvnw spring-boot:run&lt;br&gt;&lt;br&gt;Nesse modo não ocorre a cópia de frontend/; o Spring serve a versão já existente em src/main/resources/static/." vertex="1">
          <mxGeometry height="185" width="400" x="530" y="550" as="geometry" />
        </mxCell>
        <mxCell id="bld-caveat1" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEE2E2;strokeColor=#DC2626;fontColor=#7F1D1D;fontSize=12;" value="&lt;b&gt;Impedimento conhecido&lt;/b&gt;&lt;br&gt;.gitignore ignora .mvn/, mas o Dockerfile executa COPY backend/.mvn .mvn. Um clone limpo pode falhar antes do build." vertex="1">
          <mxGeometry height="120" width="450" x="40" y="820" as="geometry" />
        </mxCell>
        <mxCell id="bld-caveat2" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#FEF3C7;strokeColor=#D97706;fontColor=#78350F;fontSize=12;" value="&lt;b&gt;Duplicação do frontend&lt;/b&gt;&lt;br&gt;frontend/index.html e backend/.../static/index.html podem divergir. Docker usa frontend/; Maven local usa static/." vertex="1">
          <mxGeometry height="120" width="450" x="555" y="820" as="geometry" />
        </mxCell>
        <mxCell id="bld-caveat3" parent="1" style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;fillColor=#F1F5F9;strokeColor=#64748B;fontColor=#334155;fontSize=12;" value="&lt;b&gt;Características operacionais&lt;/b&gt;&lt;br&gt;Sem banco, sem volume, sem cache, sem CI e build com -DskipTests. O funcionamento depende das três APIs externas e de internet." vertex="1">
          <mxGeometry height="120" width="450" x="1070" y="820" as="geometry" />
