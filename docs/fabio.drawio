          </mxGeometry>
        </mxCell>

        <mxCell id="msg9" value="9. GET /v1/forecast?lat={lat}&amp;lon={lon}&amp;daily=temperature_2m_max" style="html=1;verticalAlign=bottom;endArrow=block;rounded=0;strokeWidth=2;strokeColor=#7F8C8D;" edge="1" parent="1" source="ll-climasrv" target="ll-openmeteo">
