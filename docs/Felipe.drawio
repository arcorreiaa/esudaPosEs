        <mxCell id="bld-e-stage-jar" edge="1" parent="1" source="bld-stage" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#D97706;fontColor=#92400E;fontSize=11;strokeWidth=2;" target="bld-jar" value="mvn package">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bld-e-jar-run" edge="1" parent="1" source="bld-jar" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#7C3AED;fontColor=#5B21B6;fontSize=11;strokeWidth=2;" target="bld-runtime" value="COPY --from=build">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="bld-e-run-browser" edge="1" parent="1" source="bld-runtime" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;strokeColor=#0284C7;fontColor=#075985;fontSize=11;strokeWidth=2;" target="bld-browser" value="HTTP :8080">
          <mxGeometry relative="1" as="geometry" />
